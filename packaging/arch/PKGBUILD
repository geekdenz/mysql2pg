pkgname=mysql2pg-middleware
pkgver=0.3.2
pkgrel=1
pkgdesc='MySQL-compatible SQL translation middleware backed by PostgreSQL'
arch=('x86_64' 'aarch64')
url='https://github.com/geekdenz/mysql2pg'
license=('MIT')
depends=('glibc')
source=("mysql2pg-middleware-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  install -Dm755 "${srcdir}/mysql2pg-middleware-${pkgver}/mysql2pg-middleware" "${pkgdir}/usr/bin/mysql2pg-middleware"
  install -Dm644 "${srcdir}/mysql2pg-middleware-${pkgver}/config/example.toml" "${pkgdir}/etc/mysql2pg-middleware/example.toml"
  install -Dm644 "${srcdir}/mysql2pg-middleware-${pkgver}/COPYRIGHT.md" "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT.md"
}
